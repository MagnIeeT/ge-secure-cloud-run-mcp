# ==============================================================================
# Gemini Enterprise -> Private Cloud Run MCP Server Configuration
# Copy this file to .env and fill in your GCP project values before running.
# ==============================================================================

# 1. Google Cloud Project Settings
PROJECT_ID=your-gcp-project-id
PROJECT_NUMBER=123456789012

# For Standalone VPC, set VPC_HOST_PROJECT_ID equal to PROJECT_ID.
# For Shared / Hub VPC, set VPC_HOST_PROJECT_ID to your Shared VPC Host Project ID.
VPC_HOST_PROJECT_ID=your-gcp-project-id

# Region pairing rule:
# - Use us-central1 when Gemini Enterprise app location is "global" or "us"
# - Use europe-west1 when Gemini Enterprise app location is "eu"
REGION=us-central1
GE_LOCATION=global

# Optional: Keep gcloud CLI & Vertex/Google Cloud SDKs scoped to this project
CLOUDSDK_CORE_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# 2. Cloud Run MCP Server Settings
SERVICE_NAME=private-vpc-mcp
REQUIRE_OAUTH=true
PORT=8080

# Filled automatically after deploying Cloud Run (no https:// and no trailing slash)
# Example: private-vpc-mcp-123456789012.us-central1.run.app
MCP_SERVICE_FQDN=

# 3. VPC, Subnet & PSC Network Attachment Settings
VPC_NETWORK=mcp-vpc
VPC_SUBNET=mcp-subnet
SUBNET_RANGE=10.10.0.0/24
PSC_ATTACHMENT=mcp-vpc-attachment

# 4. Egress Agent Gateway & Scoped Private Cloud DNS Settings
AGENT_GATEWAY_ID=mcp-private-gateway
DNS_ZONE_NAME=priv-zone-mcp-fqdn

# 5. Private Routing Mode ("pga" or "psc")
# - Option A ("pga"): Subnet Private Google Access VIPs (199.36.153.8/30)
# - Option B ("psc"): Global PSC Endpoint for Google APIs (all-apis -> 240.0.0.10)
ROUTING_MODE=pga
PSC_ADDRESS_NAME=ip-psc-googleapis
PSC_ENDPOINT_IP=240.0.0.10
# Note: PSC forwarding rule name must be 1-20 lowercase letters with NO hyphens
PSC_ENDPOINT_NAME=pscgoogleapis

# 6. Gemini Enterprise Custom MCP Connector Settings
# Filled after creating the Custom MCP Server data store in Gemini Enterprise
CONNECTOR_COLLECTION_ID=custom-mcp-private
